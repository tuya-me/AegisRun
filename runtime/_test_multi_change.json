{
  "preset": "standard",
  "blocked_domains": [
    "evil.com",
    "stealer.cc",
    "192.168.*",
    "10.*",
    "172.16.*",
    "127.0.0.1",
    "localhost",
    "first.com"
  ],
  "allowed_domains": [
    "api.github.com",
    "wttr.in"
  ],
  "blocked_paths": [
    "/etc/passwd",
    "/etc/shadow",
    "/proc/self/environ",
    "/root/.bash_history",
    "/var/log/auth.log",
    "~/.kube/config",
    "C:\\Users\\*\\.kube\\config",
    "C:\\Users\\*\\AppData\\Roaming\\npm\\npmrc",
    "C:\\ProgramData\\Docker\\config.json",
    "*.pem",
    "*.key",
    "*.env",
    "config.yaml"
  ],
  "blocked_env_patterns": [
    "OPENAI_API_KEY",
    "ANTHROPIC_API_KEY",
    "COHERE_API_KEY",
    "DEEPSEEK_API_KEY",
    "GOOGLE_AI_API_KEY",
    "AWS_SECRET",
    "AWS_ACCESS_KEY",
    "GCP_",
    "AZURE_",
    "ALIBABA_CLOUD",
    "TENCENT_CLOUD",
    "HUAWEI_CLOUD",
    "DATABASE_URL",
    "REDIS_URL",
    "MONGODB_URI",
    "RABBITMQ_URL",
    "POSTGRES_",
    "MYSQL_",
    "GITHUB_TOKEN",
    "GITLAB_TOKEN",
    "BITBUCKET_",
    "CIRCLECI_",
    "JENKINS_",
    "TRAVIS_",
    "SENDGRID_API",
    "TWILIO_",
    "STRIPE_",
    "SLACK_TOKEN",
    "SLACK_WEBHOOK",
    "NOTION_TOKEN",
    "DOCKER_PASSWORD",
    "DOCKER_AUTH",
    "KUBECONFIG",
    "KUBE_",
    "PRIVATE_KEY",
    "SSL_KEY",
    "CERTIFICATE",
    "PGP_",
    "GPG_",
    "NPM_TOKEN",
    "PYPI_TOKEN"
  ]
}